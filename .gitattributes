# npm normalizes package-bin shebangs to LF while linking workspaces. Keep the
# tracked bin subjects canonical so a Windows install cannot dirty the source.
packages/agenc/bin/agenc text eol=lf
runtime/bin/agenc text eol=lf
runtime/bin/agenc-linux-sandbox text eol=lf

# Runtime manifests bind every native build to the exact committed lockfile
# bytes. Keep that identity stable across Windows and POSIX checkouts.
package-lock.json text eol=lf

# FND benchmark artifacts are canonical byte-for-byte evidence. Their embedded
# digest and canonical-JSON checks require LF on every supported checkout.
runtime/benchmarks/fnd/baseline.v1.json text eol=lf
runtime/benchmarks/fnd/baseline.v1.md text eol=lf

# The red-probe runner authenticates these exact reviewed source bytes. Keep
# every digest-bound support file and registered probe stable on Windows.
runtime/tests/helpers/red-probe-bootstrap.mjs text eol=lf
runtime/tests/helpers/red-probe-markdown-loader.mjs text eol=lf
runtime/tests/helpers/red-probe.ts text eol=lf
runtime/tests/fnd/red-probes/*.red-probe.ts text eol=lf
runtime/tests/fnd/red-probes/**/*.red-probe.ts text eol=lf

# The runtime build compares this generated launcher module byte for byte with a
# fresh esbuild render, which always uses LF.
packages/agenc/generated/startup-preflight.mjs text eol=lf

# The release build hashes the fresh state schema, its generator and every
# migration source byte for byte (runtime/src/state/fresh-state-schema.sources.json).
runtime/scripts/fresh-state-schema-artifact.mjs text eol=lf
runtime/scripts/generate-fresh-state-schema.ts text eol=lf
runtime/src/agents/jobs/csv-reader.ts text eol=lf
runtime/src/agents/jobs/csv-schema.ts text eol=lf
runtime/src/contracts/csv-job-contract.ts text eol=lf
runtime/src/state/fresh-state-schema.generated.ts text eol=lf
runtime/src/state/migrations/** text eol=lf
runtime/src/utils/loadAjv.ts text eol=lf
